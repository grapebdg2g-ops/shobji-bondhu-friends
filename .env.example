# Copy to .env for local dev. NEVER commit .env with real values.
# Public (safe for VITE_*, frontend):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only (hosting env / .dev.vars — never prefix with VITE_):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# AI providers (server-only):
GEMINI_API_KEY=
LOVABLE_API_KEY=
KIMI_API_KEY=
# Web Push (server-only; public key also exposed via getVapidPublicKey):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Cron webhooks (server-only). Preferred: CRON_SECRET. Legacy fallback: PUSH_CRON_SECRET.
# Send as header: x-cron-secret: <value>
CRON_SECRET=
PUSH_CRON_SECRET=
